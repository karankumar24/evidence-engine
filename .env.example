# evidence-engine environment variables
# Copy to .env only what you want to change; every value here is optional and
# shows the default. Never commit .env.

# Database (matches docker-compose.yml)
DATABASE_URL=postgresql+asyncpg://evidenceengine:evidenceengine_dev@localhost:5432/evidenceengine

# App
UPLOAD_DIR=./uploads
INDEX_DIR=./indexes
MAX_FILE_SIZE_MB=50
DEBUG=false
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Verdict model: a copy of the NLI model trained on SciFact
# (eval/scifact/finetune.py). Empty uses cross-encoder/nli-deberta-v3-small.
NLI_MODEL_PATH=

# Retrieval
RETRIEVAL_TOP_K_BM25=5
RETRIEVAL_TOP_K_FINAL=2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2

# Explain button (optional). Any OpenAI-compatible endpoint; Gemini shown here.
# Without a key, nothing is sent to an LLM.
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_API_KEY=
GROQ_API_KEY=
MODEL_FALLBACK_CHAIN=gemini-2.0-flash,meta-llama/llama-4-scout-17b-16e-instruct

# Observability (optional)
SENTRY_DSN=
