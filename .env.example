# EvidenceEngine — environment variable reference
# Copy to .env and fill in real values. Never commit .env.

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://evidenceengine:changeme@localhost:5432/evidenceengine

# ── Application ───────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50
DEBUG=false
INDEX_DIR=./indexes

# ── CORS (comma-separated allowed origins) ────────────────────────────────────
# Default dev: http://127.0.0.1:8000,http://localhost:8000
# Production:  https://ee.yourdomain.com
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# ── LLM provider (OpenAI-compatible wire protocol) ───────────────────────────
# EvidenceEngine v1.2.9+ defaults to Google AI Studio (Gemini 2.0 Flash) as
# PRIMARY and Groq Llama 3.3 70B as FALLBACK. Both speak the OpenAI-compat wire
# protocol so the same `sync_call_with_fallback` code path handles both without
# provider branching.
#
# Free-tier quotas (as of 2026-04):
#   Gemini 2.0 Flash:   1,500 requests/day via https://aistudio.google.com/apikey
#   Groq Llama 3.3 70B: 14,400 requests/day via https://console.groq.com/keys
#
# LLM_PROVIDER is informational (telemetry/routing hint). The authoritative
# credentials are LLM_API_KEY + LLM_BASE_URL, which must point to whichever
# provider is FIRST in MODEL_FALLBACK_CHAIN. Provider-specific keys
# (GEMINI_API_KEY, GROQ_API_KEY) are used by the live-test harness and by
# v1.3+ per-model dispatch.
#
# 1) Gemini 2.0 Flash primary (RECOMMENDED — default):
LLM_PROVIDER=gemini
LLM_API_KEY=REPLACE_WITH_GEMINI_KEY
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_API_KEY=REPLACE_WITH_GEMINI_KEY
GROQ_API_KEY=REPLACE_WITH_GROQ_KEY
EXTRACTION_MODEL=gemini-2.0-flash
CLASSIFICATION_MODEL=gemini-2.0-flash
MODEL_FALLBACK_CHAIN=gemini-2.0-flash,llama-3.3-70b-versatile

# 2) Groq primary (if Gemini is blocked in your region):
#    LLM_PROVIDER=groq
#    LLM_API_KEY=<your-groq-key>
#    LLM_BASE_URL=https://api.groq.com/openai/v1
#    EXTRACTION_MODEL=llama-3.3-70b-versatile
#    CLASSIFICATION_MODEL=llama-3.3-70b-versatile
#    MODEL_FALLBACK_CHAIN=llama-3.3-70b-versatile,gemini-2.0-flash

# ── MIGRATION NOTE (v1.2.8 → v1.2.9) ─────────────────────────────────────────
# If you were running the legacy OpenRouter free chain, your old .env values
# still work as an override — nothing breaks. To migrate:
#   1. Create a Gemini key at https://aistudio.google.com/apikey
#   2. Create a Groq key at https://console.groq.com/keys
#   3. Replace LLM_BASE_URL + model ids above with the Gemini block.
# Legacy OpenRouter config for reference (NO LONGER RECOMMENDED — 98% failure
# rate observed on :free tier as of 2026-04-21):
#   LLM_BASE_URL=https://openrouter.ai/api/v1
#   EXTRACTION_MODEL=arcee-ai/trinity-large-preview:free
#   CLASSIFICATION_MODEL=arcee-ai/trinity-large-preview:free
#   MODEL_FALLBACK_CHAIN=arcee-ai/trinity-large-preview:free,nvidia/nemotron-3-super-120b-a12b:free

# 3) Real OpenAI (paid) — works unchanged:
#    LLM_PROVIDER=openai
#    LLM_API_KEY=sk-...
#    LLM_BASE_URL=
#    EXTRACTION_MODEL=gpt-4o-mini

# ── Retrieval tuning ──────────────────────────────────────────────────────────
RETRIEVAL_TOP_K_BM25=10
RETRIEVAL_TOP_K_FINAL=5
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2

# ── Verdict quality ───────────────────────────────────────────────────────────
VERDICT_NEEDS_REVIEW_THRESHOLD=0.7
VERDICT_PROMPT_VERSION=v1

# ── Observability (optional — leave blank to disable) ─────────────────────────
SENTRY_DSN=
