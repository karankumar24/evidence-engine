# EvidenceEngine — environment variable reference
# Copy to .env and fill in real values. Never commit .env.

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://evidenceengine:changeme@localhost:5432/evidenceengine

# ── Application ───────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50
DEBUG=false
INDEX_DIR=./indexes

# ── CORS (comma-separated allowed origins) ────────────────────────────────────
# Default dev: http://127.0.0.1:8000,http://localhost:8000
# Production:  https://ee.yourdomain.com
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# ── LLM provider (OpenAI-compatible wire protocol) ───────────────────────────
# This app ships configured for OpenRouter's free tier. Any OpenAI-compatible
# endpoint works — OpenRouter, Azure OpenAI, local vLLM, real OpenAI, etc.
#
# Preferred env vars: LLM_API_KEY, LLM_BASE_URL.
# Legacy OPENAI_API_KEY / OPENAI_BASE_URL are still accepted for back-compat;
# LLM_API_KEY wins when both are set.
#
# 1) OpenRouter free tier (recommended):
#    LLM_API_KEY=sk-or-v1-...                             # your OpenRouter key
#    LLM_BASE_URL=https://openrouter.ai/api/v1
#    EXTRACTION_MODEL=arcee-ai/trinity-large-preview:free
#    CLASSIFICATION_MODEL=arcee-ai/trinity-large-preview:free
#
# 2) Real OpenAI (paid):
#    LLM_API_KEY=sk-...
#    LLM_BASE_URL=                                        # leave blank
#    EXTRACTION_MODEL=gpt-4o-mini
#    CLASSIFICATION_MODEL=gpt-4o-mini
LLM_API_KEY=sk-REPLACE-ME
LLM_BASE_URL=https://openrouter.ai/api/v1
EXTRACTION_MODEL=arcee-ai/trinity-large-preview:free
CLASSIFICATION_MODEL=arcee-ai/trinity-large-preview:free

# ── Retrieval tuning ──────────────────────────────────────────────────────────
RETRIEVAL_TOP_K_BM25=10
RETRIEVAL_TOP_K_FINAL=5
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2

# ── Verdict quality ───────────────────────────────────────────────────────────
VERDICT_NEEDS_REVIEW_THRESHOLD=0.7
VERDICT_PROMPT_VERSION=v1

# ── Observability (optional — leave blank to disable) ─────────────────────────
SENTRY_DSN=
