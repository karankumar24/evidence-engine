{
  "name": "evidenceengine-frontend",
  "private": true,
  "version": "0.1.0",
  "description": "Frontend build tooling for the EvidenceEngine reviewer dashboard (Tailwind v4).",
  "scripts": {
    "build:css": "tailwindcss -i ./frontend/css/input.css -o ./src/evidenceengine/static/css/app.css --minify",
    "watch:css": "tailwindcss -i ./frontend/css/input.css -o ./src/evidenceengine/static/css/app.css --watch",
    "start": "PYTHONPATH=src .venv/bin/uvicorn evidenceengine.api.app:app --host 127.0.0.1 --port 8000",
    "test:e2e": "playwright test",
    "test:e2e:live": "BASE_URL=https://evidenceengine.fly.dev playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/cli": "^4.0.0",
    "playwright": "^1.59.1"
  }
}
